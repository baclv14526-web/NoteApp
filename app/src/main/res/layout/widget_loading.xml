<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout này CHỈ dùng làm placeholder ban đầu / preview trong widget picker.
    Glance sẽ tự thay thế toàn bộ nội dung này bằng Composable thật
    (xem PinnedNotesWidget.kt) ngay khi widget được thêm vào Home Screen.
    Android yêu cầu bắt buộc phải có initialLayout trỏ tới 1 file XML hợp lệ.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6750A4"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Đang tải ghi chú ghim..."
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</FrameLayout>
